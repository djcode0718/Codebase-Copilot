# ==============================================================================
# CodeBase-Copilot .gitignore
# ==============================================================================

# ─── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual Environments ─────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ─── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
!env.api.example
*.pem
*.key
*.cert

# ─── Local Data, Repositories & Storage ───────────────────────────────────────
# Local Chroma vector storage, cloned repos, and ephemeral index directories
data/repos/
data/index/
data/chroma/
data/health_transient_runs.json
data/*.sqlite3
data/*.sqlite3-journal
*.sqlite3
*.sqlite3-journal

# ─── Node & Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
.pnp
.pnp.*
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Testing, Coverage & Linters ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
frontend/coverage/

# ─── OS & IDE Files ───────────────────────────────────────────────────────────
.DS_Store
*/.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Logs & Diagnostics ───────────────────────────────────────────────────────
*.log
.system_generated/
.tempmediaStorage/

# ─── Notebook Checkpoints ─────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Legacy / Scratch Folders ─────────────────────────────────────────────────
src/ui-ux-pro-max/
codebase-copilot-frontend/
frontend_implementation_plan2.md
*.pre_phase1_backup/
*.backup
scratch/

# ─── External Handoff Snapshot ────────────────────────────────────────────────
CodeBase-Copilot-Handoff/

# ─── Historical Root-Level QA & Audit Working Documents ───────────────────────
# Intermediate forensic audits and verification walkthroughs
API_ENDPOINT_AUDIT.md
B4_B7_EVIDENCE_RECONCILIATION.md
B4_B7_LIVE_VERIFICATION.md
CHAT_SUPABASE_LLM_DIAGNOSTIC.md
COMPREHENSIVE_QA_PROGRESS.md
COMPREHENSIVE_QA_REPORT.md
FINAL_BROWSER_EVIDENCE_RECONCILIATION.md
FINAL_BROWSER_VERIFICATION.md
FRONTEND_INTERACTION_AUDIT.md
LLM_PROVIDER_AUDIT.md
QA_PROGRESS.md
REPOSITORY_RAG_AUDIT.md
SUPABASE_AUTH_AUDIT.md

# ─── Evaluation: Intermediate Artifacts & Historical Reports ──────────────────
# Forensic engines, stage traces, and audit logs
evaluation/e2e/forensic/
evaluation/e2e/audit/

# Evaluation expansion: exclude experimental runs, training, and raw pairs by default
evaluation/e2e/final_expansion/*
!evaluation/e2e/final_expansion/run_stabilization_evaluation.py
!evaluation/e2e/final_expansion/dataset_100_queries.jsonl
!evaluation/e2e/final_expansion/baseline_evaluation_results.json
!evaluation/e2e/final_expansion/final_stabilization_results.json
!evaluation/e2e/final_expansion/REPOSITORY_ISOLATION_SPEC.md
!evaluation/e2e/final_expansion/DATASET_SUMMARY.md

# Retrieval flow audit: exclude raw candidate traces and experiment dumps by default
evaluation/e2e/retrieval_flow_audit/*
!evaluation/e2e/retrieval_flow_audit/CANDIDATE_COUNT_OPTIMIZATION_REPORT.md

# Intermediate calibration outputs
evaluation/e2e/evaluation_pass2_results.json

# Historical and superseded evaluation reports
evaluation/e2e/COMPREHENSIVE_RETRIEVAL_PIPELINE_FORENSIC_AUDIT.md
evaluation/e2e/FINAL_STABILIZATION_REPORT.md
evaluation/e2e/PHASE2_*.md

# Temporary Git consolidation and hygiene working reports
evaluation/e2e/GIT_CONSOLIDATION_INVENTORY.md
evaluation/e2e/GITIGNORE_HYGIENE_REPORT.md

git-stabilization-backups/
